        <Property name="rows" type="int" value="5"/>
        <Property name="text" type="java.lang.String" value="ISO 100&#x2013;200: ideal para exteriores con mucha luz.  &#xa;&#xa; ISO 400&#x2013;800: &#xfa;til en interiores iluminados.  &#xa;&#xa;ISO 1600 o m&#xe1;s: permite fotografiar con poca luz, pero puede aumentar el ruido."/>
